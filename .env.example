# Copy this file to raspberry_pi/.env or export the values in your shell.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_CLIENT_ID=smart-traffic-pi
MQTT_DETECTION_TOPIC=SMdetection
MQTT_STATE_TOPIC=SMTraffic

# Camera index : lane mapping. Adjust after checking the USB camera indices.
CAMERAS=0:lane1,1:lane2,2:lane3
MODEL_PATH=../models/best.pt
PRIORITY_CLASSES=ambulance,police,fire_truck
CONFIDENCE_THRESHOLD=0.70
FRAME_SKIP=5
FRAME_WIDTH=640
FRAME_HEIGHT=360
DETECTION_COOLDOWN_SECONDS=10

# Keep false until you have verified the Raspberry Pi wiring.
GPIO_ENABLED=false
